# Modelo de /opt/planaveg/.env no servidor (chmod 600, fora do Git). As senhas são geradas lá
# por implantar.sh (openssl rand) e não saem do servidor.
DOMINIO=planaveg.exemplo.gov.br
POSTGRES_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_PG_PASSWORD=
# Opcional: outro GeoPackage em /srv/planaveg/gpkg.
# GPKG_ARQUIVO=Planaveg_2026_Categorias_Visualizacao.gpkg
# Opcional: teto do cache de tiles em GiB (padrão 40).
# GWC_COTA_GB=40
