# CLI do planaveg_core (carga do GeoPackage, views, publicação no GeoServer e semeadura), sem
# instalar Python. Construa na raiz do repositório e passe o comando no fim:
#   docker build -f infra/Dockerfile.core -t planaveg-core .
#   docker run --rm -e DATABASE_URL=... planaveg-core <comando>
# O jeito de carregar uma base está em modelagem/README.md.
FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.5.4 /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY apps/core/pyproject.toml apps/core/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/core/src ./src
RUN uv sync --frozen --no-dev

ENV PATH=/app/.venv/bin:$PATH
ENTRYPOINT ["planaveg-core"]
